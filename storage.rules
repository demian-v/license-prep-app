rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to quiz_images for authenticated users
    match /quiz_images/{allPaths=**} {
      allow read: if request.auth != null;
    }
    
    // Allow read access to theory_images for authenticated users
    match /theory_images/{allPaths=**} {
      allow read: if request.auth != null;
    }
    
    // Result-page pictures (the DriveUSA "Beep" memes). Read by signed-in,
    // non-anonymous users — the same bar as the result_memes collection;
    // written only by an operator (scripts/local/seed-result-memes.js on the
    // emulators). Risk #3 is why a bare `request.auth != null` is not used.
    match /result_memes/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Deny all other write access by default
    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
