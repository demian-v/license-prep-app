rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Risk #3 — lib/main.dart signs every visitor in anonymously, which turns
    // any bare `request.auth != null` check into "public". Content must require
    // a real account AND a live entitlement.
    function isNotAnonymous() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // `users/{uid}.isActive` is the server-maintained entitlement mirror: the
    // purchase path (receipt-validation syncUserDocument), the renewal manager
    // and the expiry schedulers all write it, and createTrialSubscription now
    // writes it too. The users/{userId} rule below makes it unwritable by
    // clients, which is what makes it safe to gate on here.
    function isEntitled() {
      return isNotAnonymous()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    // Risk #29 — fields a client must never write to its own user document.
    // A blocklist rather than an allowlist: several services write user
    // profile fields dynamically, and an allowlist would break them. These are
    // the fields that decide entitlement, which is what actually matters.
    function serverOwnedUserFields() {
      return [
        'isActive', 'subscriptionStatus', 'nextBillingDate', 'lastBillingDate',
        'packageId', 'planType', 'price', 'trialUsed', 'trialEndsAt'
      ];
    }

    // Users can read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Risk #29: was `allow read, write`, which let any user set their own
      // `isActive` — the very flag Cloud Functions use to revoke entitlement.
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(serverOwnedUserFields());
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(serverOwnedUserFields());
      allow delete: if false;
      
      // Users can read/write their own session documents
      match /sessions/{sessionDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Users can read/write their own saved questions (Updated for single-document structure)
    match /savedQuestions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow reading quiz questions, topics, etc. (read-only for all authenticated users)
    match /quizQuestions/{document} {
      allow read: if isEntitled();
    }
    
    match /quizTopics/{document} {
      allow read: if isEntitled();
    }
    
    match /trafficRuleTopics/{document} {
      allow read: if isEntitled();
    }
    
    match /theoryModules/{document} {
      allow read: if isEntitled();
    }
    
    match /practiceTests/{document} {
      allow read: if isEntitled();
    }
    
    // User-specific report counters - each user can manage their own counter
    match /counters/{counterId} {
      allow read, write: if request.auth != null 
        && counterId.matches('user_[^_]+_reports')
        && counterId == ('user_' + request.auth.uid + '_reports');
    }
    
    // Global report counter - read-only; updates must be exactly +1 increment
    match /counters/global_report_counter {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.value == resource.data.value + 1
        && request.resource.data.keys().hasOnly(['value', 'lastUpdated', 'description']);
      allow create: if false;
      allow delete: if false;
    }
    
    // Reports collection - consolidated rule for all report operations
    match /reports/{reportId} {
      // Allow authenticated users to create reports with proper validation
      allow create: if request.auth != null
        && (
          // Allow new global format: {number}_user_{userId}_report_{number}
          reportId.matches('[0-9]+_user_' + request.auth.uid + '_report_[0-9]+') ||
          // Allow legacy format: user_{userId}_report_{number} (for backward compatibility)
          reportId.matches('user_' + request.auth.uid + '_report_[0-9]+') ||
          // Allow global fallback IDs: {timestamp}_user_{userId}_report_fallback_{random}
          reportId.matches('[0-9]+_user_' + request.auth.uid + '_report_fallback_[0-9]+') ||
          // Allow legacy fallback IDs with timestamps (temporary support)
          reportId.matches('user_' + request.auth.uid + '_report_[0-9]+_[0-9]+_[0-9]+')
        )
        && request.resource.data.keys().hasAll(['createdAt','reason','contentType','status'])
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['image','translation','other']
        && (
          (request.resource.data.contentType == 'quiz_question' &&
           request.resource.data.entity.keys().hasAll(['questionId','path'])) ||
          (request.resource.data.contentType == 'theory_section' &&
           request.resource.data.entity.keys().hasAll(['topicDocId','sectionIndex','path'])) ||
          (request.resource.data.contentType == 'profile_section' &&
           request.resource.data.entity.keys().hasAll(['source','path']))
        )
        && (request.resource.data.reason != 'other' ||
            (request.resource.data.message is string &&
             request.resource.data.message.size() >= 10));

      // Allow admins to manage all reports
      allow read, update, delete: if isAdmin();
      
      // Allow admins to read legacy reports (preserve existing functionality)
      allow read: if isAdmin() && !reportId.matches('user_.*_report_[0-9]+');
    }
    
    // Subscriptions collection - read-only for owner, all writes go through Cloud Functions
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }
    
    // NEW: SubscriptionsType collection - read-only for authenticated users
    match /subscriptionsType/{planId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can modify via Firebase Console
    }
    
    // admins — membership is the gate for both isAdmin() above and requireAdmin()
    // in Cloud Functions. Never client-readable or client-writable; provision
    // through the Firebase console. Covered by the default deny below too, but
    // stated explicitly because it decides privilege.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // webhookDeadLetter — failed store notifications kept for replay (risk #9).
    // Contains raw Apple/Google payloads, so never client-readable.
    match /webhookDeadLetter/{failureId} {
      allow read, write: if false;
    }

    // processedWebhooks — written by Cloud Functions admin SDK only (webhook dedup)
    match /processedWebhooks/{docId} {
      allow read, write: if false;
    }

    // trialDevices — written by Cloud Functions admin SDK only (trial abuse prevention)
    match /trialDevices/{deviceHash} {
      allow read, write: if false;
    }

    // contentMeta — the content cache-bust version (risk #47). Served by the
    // getContentVersion callable so there is exactly one path to it, and
    // writable only by an operator through the console or a server-side script.
    // A client that could write this could force every device to refetch.
    match /contentMeta/{docId} {
      allow read, write: if false;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
