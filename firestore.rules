rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Risk #3 — lib/main.dart signs every visitor in anonymously, which turns
    // any bare `request.auth != null` check into "public". Content must require
    // a real account AND a live entitlement.
    function isNotAnonymous() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // `users/{uid}.isActive` is the server-maintained entitlement mirror: the
    // purchase path (receipt-validation syncUserDocument), the renewal manager
    // and the expiry schedulers all write it, and createTrialSubscription now
    // writes it too. The users/{userId} rule below makes it unwritable by
    // clients, which is what makes it safe to gate on here.
    function isEntitled() {
      return isNotAnonymous()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    // Risk #29 — fields a client must never write to its own user document.
    // A blocklist rather than an allowlist: several services write user
    // profile fields dynamically, and an allowlist would break them. These are
    // the fields that decide entitlement, which is what actually matters.
    function serverOwnedUserFields() {
      return [
        'isActive', 'subscriptionStatus', 'nextBillingDate', 'lastBillingDate',
        'packageId', 'planType', 'price', 'trialUsed', 'trialEndsAt',
        // Instructors plan v2: the role is granted only by registerAsInstructor.
        // `signupRole`/`signupKind` stay client-writable — they are intent
        // (which signup screens to resume), not privilege.
        'userType'
      ];
    }

    // Users can read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Risk #29: was `allow read, write`, which let any user set their own
      // `isActive` — the very flag Cloud Functions use to revoke entitlement.
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(serverOwnedUserFields());
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(serverOwnedUserFields());
      allow delete: if false;
      
      // Users can read/write their own session documents
      match /sessions/{sessionDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // FCM registration tokens, one doc per device (plan v2 §12). Written by
      // the owner directly: no privilege rides on a token.
      match /fcmTokens/{tokenId} {
        allow read, delete: if isNotAnonymous() && request.auth.uid == userId;
        allow create, update: if isNotAnonymous() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['ios', 'android'];
      }
    }
    
    // Users can read/write their own saved questions (Updated for single-document structure)
    match /savedQuestions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow reading quiz questions, topics, etc. (read-only for all authenticated users)
    match /quizQuestions/{document} {
      allow read: if isEntitled();
    }
    
    match /quizTopics/{document} {
      allow read: if isEntitled();
    }
    
    match /trafficRuleTopics/{document} {
      allow read: if isEntitled();
    }
    
    match /theoryModules/{document} {
      allow read: if isEntitled();
    }
    
    match /practiceTests/{document} {
      allow read: if isEntitled();
    }
    
    // User-specific report counters - each user can manage their own counter
    // The per-user report counter, written in the SAME transaction as the
    // global one by CounterService.getNextGlobalReportId. It used to carry a
    // bare `allow read, write`, so its owner could rewind it — and because
    // reports are written with .set() rather than .create(), the next report
    // then landed on an id already in use and silently overwrote the earlier
    // one. A user could erase their own report history with nothing recording
    // it. The global counter was tightened for risk #11; this is its sibling,
    // closed 2026-09-19.
    //
    // The writer sends exactly { value, lastUpdated, userId } with merge:true,
    // so a first report is a CREATE at 1 and every later one is +1.
    match /counters/{counterId} {
      function isOwnCounter() {
        return request.auth != null
          && counterId.matches('user_[^_]+_reports')
          && counterId == ('user_' + request.auth.uid + '_reports');
      }

      allow read: if isOwnCounter();
      allow create: if isOwnCounter()
        && request.resource.data.value == 1
        && request.resource.data.keys().hasOnly(['value', 'lastUpdated', 'userId']);
      allow update: if isOwnCounter()
        && request.resource.data.value == resource.data.value + 1
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['value', 'lastUpdated', 'userId']);
      allow delete: if false;
    }
    
    // Global report counter - updates must be exactly +1 increment.
    //
    // Risk #11. This rule used to contradict the writer it exists to serve.
    // CounterService increments with set(merge: true), so:
    //
    //   - `create: if false` denied the FIRST increment, because a merge-set on
    //     a document that does not exist yet is a create. The counter could
    //     never bootstrap, so the first report ever filed failed.
    //
    //   - `keys().hasOnly([...])` was evaluated on the MERGED document rather
    //     than on what changed. initializeGlobalCounterFromExistingReports and
    //     resetGlobalCounter write createdAt / initializedFrom / initialCount,
    //     so once either had run those keys came through every later merge and
    //     every increment was denied permanently.
    //
    // `diff(resource.data).affectedKeys()` asks the question the rule meant to
    // ask: which fields is this write actually changing?
    match /counters/global_report_counter {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.value == 1
        && request.resource.data.keys().hasOnly(['value', 'lastUpdated', 'description']);
      allow update: if request.auth != null
        && request.resource.data.value == resource.data.value + 1
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['value', 'lastUpdated', 'description']);
      allow delete: if false;
    }
    
    // Reports collection - consolidated rule for all report operations
    match /reports/{reportId} {
      // Allow authenticated users to create reports with proper validation
      allow create: if request.auth != null
        && (
          // Allow new global format: {number}_user_{userId}_report_{number}
          reportId.matches('[0-9]+_user_' + request.auth.uid + '_report_[0-9]+') ||
          // Allow legacy format: user_{userId}_report_{number} (for backward compatibility)
          reportId.matches('user_' + request.auth.uid + '_report_[0-9]+') ||
          // Allow global fallback IDs: {timestamp}_user_{userId}_report_fallback_{random}
          reportId.matches('[0-9]+_user_' + request.auth.uid + '_report_fallback_[0-9]+') ||
          // Allow legacy fallback IDs with timestamps (temporary support)
          reportId.matches('user_' + request.auth.uid + '_report_[0-9]+_[0-9]+_[0-9]+')
        )
        // Risk #45 — the body's userId must be the caller's, not just the
        // document ID. Only the ID was bound to the uid before, so a report
        // could be filed under your own ID while attributing the complaint to
        // somebody else — straight into admin triage.
        && request.resource.data.keys().hasAll(['createdAt','reason','contentType','status','userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['image','translation','other']
        && (
          (request.resource.data.contentType == 'quiz_question' &&
           request.resource.data.entity.keys().hasAll(['questionId','path'])) ||
          (request.resource.data.contentType == 'theory_section' &&
           request.resource.data.entity.keys().hasAll(['topicDocId','sectionIndex','path'])) ||
          (request.resource.data.contentType == 'profile_section' &&
           request.resource.data.entity.keys().hasAll(['source','path']))
        )
        && (request.resource.data.reason != 'other' ||
            (request.resource.data.message is string &&
             request.resource.data.message.size() >= 10));

      // Risk #45 — a user can read back what they filed. Without this the
      // feature was write-only for everyone: reads were admin-only, and the
      // `admins` collection does not exist in production (verified 2026-08-20),
      // so isAdmin() is false for every caller and nothing could read reports
      // at all. Scoped to the body's userId, which create now pins to the
      // caller, so this cannot widen into reading someone else's complaint.
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Update and delete stay admin-only: triage state is not the reporter's
      // to change, and a user must not be able to reopen or close their own
      // complaint.
      allow read, update, delete: if isAdmin();
    }
    
    // Subscriptions collection - read-only for owner, all writes go through Cloud Functions
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }
    
    // NEW: SubscriptionsType collection - read-only for authenticated users
    match /subscriptionsType/{planId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can modify via Firebase Console
    }
    
    // admins — membership is the gate for both isAdmin() above and requireAdmin()
    // in Cloud Functions. Never client-readable or client-writable; provision
    // through the Firebase console. Covered by the default deny below too, but
    // stated explicitly because it decides privilege.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // webhookDeadLetter — failed store notifications kept for replay (risk #9).
    // Contains raw Apple/Google payloads, so never client-readable.
    match /webhookDeadLetter/{failureId} {
      allow read, write: if false;
    }

    // emailVerificationCodes — outstanding 6-digit codes (risk #12).
    //
    // Client-deny in both directions, and the read side is the important one:
    // the codes are stored hashed and salted, but a readable record would still
    // leak the attempt count and expiry, and a writable one would let a user
    // reset their own attempt counter — which would turn the 5-guess cap into
    // no cap at all on a 10^6 space. Only the Admin SDK touches this.
    match /emailVerificationCodes/{uid} {
      allow read, write: if false;
    }

    // processedWebhooks — written by Cloud Functions admin SDK only (webhook dedup)
    match /processedWebhooks/{docId} {
      allow read, write: if false;
    }

    // trialDevices — written by Cloud Functions admin SDK only (trial abuse prevention)
    match /trialDevices/{deviceHash} {
      allow read, write: if false;
    }

    // result_memes — which picture a result page shows (bucket, Storage path,
    // size). Not paid content, so no entitlement gate, but not anonymous either
    // (risk #3). Written only by an operator or the emulator seed script.
    match /result_memes/{memeId} {
      allow read: if isNotAnonymous();
      allow write: if false;
    }

    // contentMeta — the content cache-bust version (risk #47). Served by the
    // getContentVersion callable so there is exactly one path to it, and
    // writable only by an operator through the console or a server-side script.
    // A client that could write this could force every device to refetch.
    match /contentMeta/{docId} {
      allow read, write: if false;
    }

    // ── Instructors marketplace — plan v2 (vault raw/drive_usa/2026-09-30) ──
    //
    // Students never read instructor data directly. The listing, profiles and
    // reviews are served by callables gated on requirePaidSubscriber
    // (functions/src/entitlement.ts): trial users are locked out, and the
    // trial/paid distinction lives only on subscriptions docs, which a rule
    // cannot query. Here only the owner reads their own doc.
    match /instructors/{uid} {
      // An ALLOWLIST, unlike serverOwnedUserFields: the collection is new, so
      // nothing depends on writing fields outside it. Everything else —
      // listed, stage, idCheck, licenseCheck, photoUrl, ratings, payouts,
      // timezone — is written by Cloud Functions only.
      function ownerEditableFields() {
        return [
          'name', 'city', 'cityKey', 'languages', 'schoolName',
          'schoolAddress', 'fleetSize', 'instructorCount',
          'carModel', 'carYear', 'hasDualControls', 'bio',
          'hourlyRateCents', 'lessonDurations', 'availability',
          'status', 'updatedAt'
        ];
      }
      allow read: if isNotAnonymous() && request.auth.uid == uid;
      allow update: if isNotAnonymous() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(ownerEditableFields())
        // `suspended` is admin-only, and a suspended owner cannot leave it.
        && resource.data.status != 'suspended'
        && request.resource.data.status in ['active', 'deactivated']
        && request.resource.data.hourlyRateCents is int
        && request.resource.data.hourlyRateCents >= 2000
        && request.resource.data.hourlyRateCents <= 20000
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 600
        && request.resource.data.availability is map;
      allow create, delete: if false;

      // One review per student (doc id = studentUid), written by submitReview.
      match /reviews/{studentUid} {
        allow read: if isNotAnonymous() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Phone, contact email, Stripe ids, verification and licence data.
    match /instructorPrivate/{uid} {
      allow read, write: if false;
    }

    // One doc per booked 30-minute block; tx.create() is the double-booking lock.
    match /bookingSlots/{slotId} {
      allow read, write: if false;
    }

    // Public count per state for the paywall preview — no instructor data.
    match /instructorStats/{state} {
      allow read: if isNotAnonymous();
      allow write: if false;
    }

    // Operator-set configuration. Only the instructors doc (launchStates) is
    // readable; any future config doc stays closed until it is listed here.
    match /config/{docId} {
      allow read: if isNotAnonymous() && docId == 'instructors';
      allow write: if false;
    }

    match /favorites/{uid} {
      allow read, delete: if isNotAnonymous() && request.auth.uid == uid;
      allow create, update: if isNotAnonymous() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['instructorUids', 'updatedAt'])
        && request.resource.data.instructorUids is list
        && request.resource.data.instructorUids.size() <= 200;
    }

    // Written only by sendMessage / the booking webhook (masking and the
    // pre-booking rate limit live there).
    match /conversations/{convId} {
      allow read: if isNotAnonymous()
        && request.auth.uid in resource.data.participantUids;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isNotAnonymous()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids;
        allow write: if false;
      }
    }

    match /bookings/{bookingId} {
      allow read: if isNotAnonymous()
        && (request.auth.uid == resource.data.studentUid
            || request.auth.uid == resource.data.instructorUid);
      allow write: if false;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
