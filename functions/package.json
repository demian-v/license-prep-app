{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --project demo-driveusa --only firestore,auth,pubsub \"jest\"",
    "test:watch": "firebase emulators:exec --project demo-driveusa --only firestore,auth,pubsub \"jest --watch\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^3.0.0",
    "@types/nodemailer": "^8.0.2",
    "axios": "^1.13.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.0.6",
    "googleapis": "^169.0.0",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "firebase-functions-test": "^3.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^4.9.0"
  },
  "private": true
}
